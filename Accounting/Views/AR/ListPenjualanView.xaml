<UserControl x:Class="Accounting.Views.AR.ListPenjualanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Accounting.Views.AR"
             xmlns:ctrl="clr-namespace:Accounting.Views.Controls"
             xmlns:conv="clr-namespace:Accounting.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
             
    <UserControl.Resources>
        <conv:DetailsToProductNamesConverter x:Key="DetailsToProducts" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Search panel -->
        <StackPanel Grid.Column="0" Margin="3" VerticalAlignment="Top" >
            <TextBlock Text="Search Penjualan" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="No Penjualan" />
            <TextBox Text="{Binding NoPenjualan, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Periode" Margin="0,8,0,0"/>
            <ctrl:DateRangePickerControl DataContext="{Binding DateRange}" />

            <TextBlock Text="Customer" Margin="0,2,0,0"/>
            
            <!-- replace existing CustomerCombo element with this -->

            <ctrl:CustomerCombo
    SelectedCustomerId="{Binding SelectedCustomerId, Mode=TwoWay}"
    CustomerService="{Binding CustomerService}" />
            

            <TextBlock Text="Keterangan" Margin="0,2,0,0"/>
            <TextBox Text="{Binding Keterangan, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Product" Margin="0,8,0,0"/>
            <ctrl:ProductCombo
SelectedProductId="{Binding SelectedProductId, Mode=TwoWay}"
ProductService="{Binding ProductService}" />

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Search" Command="{Binding SearchCommand}" Width="80"/>
                <Button Content="Clear" Command="{Binding ClearCommand}" Width="80" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="LightGray"/>

        <!-- Result list -->
        <DockPanel Grid.Column="2" Margin="8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="0,0,0,8">
                <Button Content="Tambah" Command="{Binding AddCommand}" Width="100"/>
            </StackPanel>

            <DataGrid Style="{StaticResource DataGridStandar}" ItemsSource="{Binding Results}"
                      SelectedItem="{Binding SelectedPenjualan, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Visibility="Hidden" />
                    <DataGridTemplateColumn Header="Detail" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Detail"
                                        Command="{Binding DataContext.ShowDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="No Penjualan" Binding="{Binding Description}" Width="200" />
                    <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal}" Width="140" />
                    <DataGridTextColumn Header="Customer" Binding="{Binding CUstomerName}" Width="200" />
                    <DataGridTextColumn Header="Keterangan" Binding="{Binding Description}" Width="200" />
                    <DataGridTextColumn Header="Products" Binding="{Binding Details, Converter={StaticResource DetailsToProducts}}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
