<Window x:Class="Accounting.Views.AR.PenjualanDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:ctrl="clr-namespace:Accounting.Views.Controls"
        xmlns:conv="clr-namespace:Accounting.Converters"
        xmlns:local="clr-namespace:Accounting.Views.AR"
         xmlns:vm="clr-namespace:Accounting.ViewModels.AR"
        mc:Ignorable="d"        
    Title="Penjualan Detail"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="500"
        MinHeight="700">
    <Window.Resources>
        <conv:DetailsToIndexConverter x:Key="DetailsToIndexConverter" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Entry Penjualan" FontSize="16" FontWeight="Bold" />

        <!-- Header fields -->
        <Grid Grid.Row="2" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="No. Penjualan" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NoDokumen, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Tanggal" Margin="0,8,0,4"/>
                <DatePicker SelectedDate="{Binding Tanggal, Mode=TwoWay}" />

                <TextBlock Text="Customer" Margin="0,8,0,4"/>
                <ctrl:CustomerCombo
                    SelectedCustomerId="{Binding SelectedCustomerId, Mode=TwoWay}"
                    CustomerService="{Binding DataContext.CustomerService, RelativeSource={RelativeSource AncestorType=Window}}"
                    Margin="0,0,0,4"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Keterangan" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Keterangan, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="96" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Details grid -->
        <DataGrid Style="{StaticResource DataGridStandar}" Grid.Row="4"
                  x:Name="dgDetails"
                  ItemsSource="{Binding Details}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Margin="0,6,0,6"
                  IsReadOnly="False"
                  CanUserDeleteRows="False"
                  LoadingRow="DataGrid_LoadingRow"
                  PreparingCellForEdit="DataGrid_PreparingCellForEdit"
                  CellEditEnding="DataGrid_CellEditEnding" Height="300">

            


            <DataGrid.Columns>
                <DataGridTextColumn Header="No" IsReadOnly="True" Width="60"
                                    Binding="{Binding Path=., Converter={StaticResource DetailsToIndexConverter}, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>

                <!-- Product column using ProductCombo control -->
                <DataGridTemplateColumn Header="Product" Width="360">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ctrl:ProductCombo
                                SelectedProductId="{Binding ProductId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ProductService="{Binding DataContext.ProductService, RelativeSource={RelativeSource AncestorType=Window}}"
                                />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Harga Jual -->
                <DataGridTextColumn Header="Harga Jual" Binding="{Binding SellingPrice, Mode=TwoWay, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="140" />

                <!-- Jumlah (Quantity) -->
                <DataGridTextColumn Header="Jumlah" Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="100" />

                <!-- Total -->
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" IsReadOnly="True" Width="140"/>

               
                <!-- Hapus -->
                <DataGridTemplateColumn Header="Hapus" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Hapus"
                                    Command="{Binding DataContext.RemoveDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Width="70"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Totals -->
        <Grid Grid.Row="5" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="25"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="16" Text="Jumlah:" FontWeight="Bold" />
            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="16"    Text="{Binding DetailsQuantityTotal, StringFormat=N0}" FontWeight="Bold"/>

            <TextBlock Grid.Row="1" Grid.Column="0" FontSize="16" Text="Total Penjualan:" FontWeight="Bold" />
            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="16" Text="{Binding DetailsTotal, StringFormat=N2}" FontWeight="Bold"/>
            
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" >
            <Button Content="Tambah" Width="90" Command="{Binding AddDetailLineCommand}" Margin="0,0,8,0"/>
            <Button Content="Simpan" Width="90" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
            <Button Content="Update" Width="90" Command="{Binding UpdateCommand}" Margin="0,0,8,0"/>
            <Button Content="Hapus" Width="90" Command="{Binding DeleteCommand}" Margin="0,0,8,0"/>
            <Button Content="Tutup" Width="90" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>

</Window>
