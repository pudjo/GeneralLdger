<UserControl x:Class="Accounting.Views.AR.CustomerEntryView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Accounting.Views.AR"
        mc:Ignorable="d"
                     MinHeight="380" MinWidth="600">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Customer Entry" FontSize="16" FontWeight="Bold" />

        <Border Grid.Row="2" Padding="12" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock Text="Code" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Text="Name" Margin="0,8,0,4" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Text="Phone (Mobile)" Margin="0,8,0,4" />
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <TextBlock Text="Company" Margin="0,8,0,4" />
                    <TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                    <CheckBox Content="Is Active" IsChecked="{Binding IsActive}" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <TextBlock Text="Address" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="120" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Email" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Tax / NPWP" />
                            <TextBox Text="{Binding TaxId, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Add" Width="90" Command="{Binding AddCommand}" Margin="0,0,8,0"/>
            <Button Content="Save" Width="90" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
            <Button Content="Update" Width="90" Command="{Binding UpdateCommand}" Margin="0,0,8,0"/>
            <Button Content="Delete" Width="90" Command="{Binding DeleteCommand}" Margin="0,0,8,0"/>
            <Button Content="Close" Width="90" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
