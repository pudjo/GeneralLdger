<UserControl x:Class="Accounting.Views.CompanySettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Accounting.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="White"
             >
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
                <!-- Area Logo -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="100"/>
            </Grid.RowDefinitions>

            <!-- Nama Perusahaan -->
            <Label Grid.Row="0" Content="Nama Perusahaan" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentCompany.Nama, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <!-- Email -->
            <Label Grid.Row="1" Content="Email" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentCompany.Email, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <!-- No HP -->
            <Label Grid.Row="2" Content="No. HP" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentCompany.NoHP, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <!-- Alamat -->
            <Label Grid.Row="3" Content="Alamat" VerticalAlignment="Top"/>
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentCompany.Alamat, UpdateSourceTrigger=PropertyChanged}" 
                  TextWrapping="Wrap" AcceptsReturn="True" Height="60" Margin="5"/>

            <!-- NPWP -->
            <Label Grid.Row="4" Content="NPWP" VerticalAlignment="Center"/>
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CurrentCompany.NPWP, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <!-- No Akta -->
            <Label Grid.Row="5" Content="No. Akta" VerticalAlignment="Center"/>
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CurrentCompany.NoAkta, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <!-- Logo Section -->
            <StackPanel Grid.Row="0" Grid.RowSpan="6" Grid.Column="2" Margin="15,5,5,5">
                <Border BorderBrush="Gray" BorderThickness="1" Height="150" Width="150">
                    <Image Source="{Binding CompanyLogoImage}" Stretch="Uniform"/>
                </Border>
                <Button Content="Pilih Logo" Command="{Binding ChangeLogoCommand}" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Simpan Button -->
            <Button Grid.Row="9" Grid.Column="1" Content="Simpan Pengaturan" 
                 Command="{Binding SaveCommand}" Width="150" HorizontalAlignment="Right" Margin="5"/>
        </Grid>
    </ScrollViewer>
</UserControl>
