<Window x:Class="Accounting.Views.Inventory.JenisDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Accounting.Views.Inventory"
        mc:Ignorable="d"
         Title="Jenis Detail" Height="500" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Deaaaatail Jenis" FontSize="20" FontWeight="Bold" />

        <Grid Grid.Row="1" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,8,0">
                <TextBlock Text="Nama:" FontSize="16" Margin="0,6"/>
                <TextBlock Text="Kode:" FontSize="16" Margin="0,6"/>
                <TextBlock Text="Parent:" FontSize="16" Margin="0,6"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Vertical">
                <TextBox Text="{Binding Item.Nama, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, 
                     ValidatesOnDataErrors=True}" Margin="0,4"/>
                <TextBox Text="{Binding Item.Kode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Margin="0,4"/>
                
                <ComboBox ItemsSource="{Binding ParentList}" DisplayMemberPath="Nama" SelectedValuePath="ID"
                          SelectedValue="{Binding Item.ParentID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2">
            <Button Content="Simpan" Width="100" Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
            <Button Content="Batal" Width="100" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>

</Window>
