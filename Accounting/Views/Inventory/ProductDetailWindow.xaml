<Window x:Class="Accounting.Views.Inventory.ProductDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Accounting.Views.Inventory"
        mc:Ignorable="d"
                Title="Product Detail" Height="380" Width="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Detail Produk" FontSize="16" FontWeight="Bold" />

        <Grid Grid.Row="1" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,8,0">
                <TextBlock Text="Kode:" Margin="0,6"/>
                <TextBlock Text="Nama:" Margin="0,6"/>
                <TextBlock Text="Harga Beli:" Margin="0,6"/>
                <TextBlock Text="Harga Jual:" Margin="0,6"/>
                <TextBlock Text="Stok:" Margin="0,6"/>
                <TextBlock Text="Jenis:" Margin="0,6"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Vertical">
                <TextBox Text="{Binding Item.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                <TextBox Text="{Binding Item.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                <TextBox Text="{Binding Item.PurchasePrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Margin="0,4"/>
                <TextBox Text="{Binding Item.CurrentSellingPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Margin="0,4"/>
                <TextBox Text="{Binding Item.CurrentStock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>

                <!-- Jenis: readonly textbox + Cari button -->
                <DockPanel Margin="0,4">
                    <TextBox Text="{Binding Item.JenisNama, Mode=OneWay}" IsReadOnly="True" VerticalAlignment="Center" />
                    <Button Content="Cari Jenis" Command="{Binding SearchJenisCommand}" Margin="8,0,0,0" Padding="8,4" />
                </DockPanel>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="2">
            <Button Content="Simpan" Width="100" Margin="0,0,8,0" Command="{Binding SaveCommand}"/>
            <Button Content="Batal" Width="100" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>


