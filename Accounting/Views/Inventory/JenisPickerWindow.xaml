<Window x:Class="Accounting.Views.Inventory.JenisPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:views="clr-namespace:Accounting.Views.Inventory"

        xmlns:local="clr-namespace:Accounting.Views.Inventory"
        mc:Ignorable="d"
   Title="Pilih Jenis" Height="500" Width="360" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- reuse existing JenisTreeView user control -->
        <views:JenisTreeView x:Name="JenisTree" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1" Margin="0,8,0,0">
            <Button Content="OK" Width="90" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Batal" Width="90" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>

</Window>
