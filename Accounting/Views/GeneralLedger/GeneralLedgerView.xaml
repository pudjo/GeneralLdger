<UserControl x:Class="Accounting.Views.GeneralLedger.GeneralLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Accounting.Views.GeneralLedger"
             xmlns:controls="clr-namespace:Accounting.Views.Controls"

             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="2">
        <Grid.ColumnDefinitions>
    
            <ColumnDefinition Width="300" MinWidth="200"/>
    
            <ColumnDefinition Width="Auto"/>
    
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

<!-- Pencarian -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Date -->
            <Border Grid.Row="0" Background="#F9F9F9" CornerRadius="4" Padding="10" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Periode Laporan" FontWeight="Bold" Margin="0,0,0,8" Foreground="#2C3E50"/>
                    <controls:DateRangePickerControl DataContext="{Binding DateRangePicker}"/>

                    

                </StackPanel>
            </Border>

            <!-- Kotak Pencarian Akun -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid  Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontWeight="Bold" Text="Akun" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
     Background="White" 
     BorderBrush="#AAAAAA"
     Height="30"
     BorderThickness="1"
     VerticalContentAlignment="Center"
     Padding="5" 
     Grid.Column="1" 
     Margin="0,0,5,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="2" Content=" Cari " 
    Command="{Binding SearchCommand}" 
    Padding="15,5" Background="#3498DB" Foreground="White" BorderThickness="0"/>
                </Grid>
                <TreeView Grid.Row="1"  SelectedItemChanged="TreeView_SelectedItemChanged" ItemsSource="{Binding AkunTreeList}" Background="White"   
      BorderBrush="#DDDDDD"
                           VirtualizingStackPanel.IsVirtualizing="True">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="FontWeight" Value="Normal" />

                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>

                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" 
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                <TextBlock Text="{Binding Id}" Margin="0,0,5,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                                    <Setter Property="Foreground" Value="Blue"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Text="{Binding Name}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="Blue"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                
            </Grid>
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="Akun Terpilih:" FontSize="11" Foreground="#555555" Margin="0,0,0,4"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             Text="{Binding SelectedAkun.Id, Mode=OneWay}" 
                             FontWeight="Bold" 
                             FontSize="13" 
                             Height="28"
                             VerticalContentAlignment="Center" 
                             Padding="5,0"
                             IsReadOnly="True" 
                             Background="#F5F5F5" 
                             BorderBrush="#DDDDDD"/>

                    <TextBox Grid.Column="2" 
                             Text="{Binding SelectedAkun.Name, Mode=OneWay}" 
                             FontSize="13" 
                             Height="28"
                             VerticalContentAlignment="Center" 
                             Padding="5,0"
                             IsReadOnly="True" 
                             Background="#F5F5F5" 
                             BorderBrush="#DDDDDD"/>
                </Grid>

                <CheckBox Content="Hanya tampilkan akun ini saja" 
                          IsChecked="{Binding IsOnlySelectedAkun, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                          Margin="0,12,0,0" 
                          FontWeight="SemiBold"
                          Foreground="#2C3E50"
                          VerticalContentAlignment="Center"/>
            </StackPanel>

            <Border Grid.Row="3">
                <!-- Tombol Tampilkan Data Utama -->
                <Button Content="Tampilkan Data" 
                        Command="{Binding LoadGeneralLedgerCommand}"
                        Margin="0,12,0,0" 
                        Padding="0,8" 
                        Background="#2ECC71" 
                        Foreground="White" 
                        FontWeight="Bold"
                        BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

            </Border>
            
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#E0E0E0"/>
<!-- Data Grid -->
        <Grid Grid.Column="2" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <!-- Header Informasi Ringkas -->
                <RowDefinition Height="Auto"/>
                <!-- DataGrid Utama -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Informasi Buku Besar Aktif -->
            <Border Grid.Row="0" Background="#34495E" Padding="12" CornerRadius="4" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="BUKU BESAR (GENERAL LEDGER)" Foreground="White" FontSize="14" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Akun Terpilih: " Foreground="#BDC3C7" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedAkun.Id}" Foreground="#F1C40F" FontSize="12" FontWeight="Bold" Margin="4,0,0,0"/>
                            <TextBlock Text=" - " Foreground="#BDC3C7" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedAkun.Name}" Foreground="#F1C40F" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Margin="20,0,0,20" >
                            <TextBlock Text="Cari: " Foreground="White" FontSize="18"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                            
                            <TextBox Text="{Binding KataKunciPencarian,  UpdateSourceTrigger=PropertyChanged}"  Background="White"  BorderBrush="#AAAAAA"
                             Height="30"
                                 Width="250" 
                             BorderThickness="1"                             VerticalContentAlignment="Center"
                             Padding="5" 
                             Margin="0,0,5,0">

                            </TextBox>
                        </StackPanel>
                    <Grid Grid.Column="2" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Saldo Awal " Foreground="#BDC3C7" FontSize="12"
                          Grid.Column="0"
                          Grid.Row="0"/>
                        <TextBlock Text="Jumlah Debet" Foreground="#BDC3C7" FontSize="12"
                          Grid.Column="1"
                          Grid.Row="0"/>
                        <TextBlock Text="Jumlah Credit" Foreground="#BDC3C7" FontSize="12"
                            Grid.Column="2"
                            Grid.Row="0"/>
                        <TextBlock Text="{Binding SaldoAwal,  StringFormat='{}{0:C}'}" 
                                   TextAlignment="Right" Foreground="White" FontSize="12" FontWeight="Bold"
                        Grid.Column="0" Padding="10"
Grid.Row="1"/>
                        <TextBlock Text="{Binding TotalDebet, StringFormat='{}{0:C}'}" TextAlignment="Right" Foreground= "White" FontSize="12" FontWeight="Bold"
                        Grid.Column="1" Padding="10"
Grid.Row="1"/>

                        <TextBlock Text="{Binding TotalCredit , StringFormat='{}{0:C}'}" 
                                   TextAlignment="Right" 
                                   Foreground="White" FontSize="12" FontWeight="Bold"  Padding="10"                                                          Grid.Column="2"
Grid.Row="1"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- DataGrid General Ledger DTO -->
            <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding GeneralLedgerRows}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  BorderBrush="#DDDDDD"
                  Background="White"
                  RowBackground="#FFFFFF"
                  AlternatingRowBackground="#FBFBFB"
                       >

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#EAEDED"/>
                        <Setter Property="Foreground" Value="#2C3E50"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderBrush" Value="#D5D8DC"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="2,0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>

                        <Setter Property="VerticalContentAlignment" Value="Center"/>

                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <!-- Kolom Tanggal -->
                    <DataGridTextColumn Header="Tanggal" 
                                    Binding="{Binding TrxDate, StringFormat=dd-MMM-yyyy}" 
                                    Width="90"/>

                    <!-- Kolom No. Bukti / Referensi -->
                    <DataGridTextColumn Header="No. Bukti" 
                                    Binding="{Binding RefNo}" 
                                    Width="120" ElementStyle="{StaticResource TextStyleWrapping}"/>

                    <!-- Kolom Keterangan (Dibuat lebar fleksibel) -->
                    <DataGridTextColumn Header="Keterangan" 
                                    Binding="{Binding Description}" ElementStyle="{StaticResource TextStyleWrapping}" 
                                    Width="*"/>

                    <DataGridTextColumn Header="Kode Akun" 
                Binding="{Binding AccountCode}" 
                Width="90"/>
                    <DataGridTextColumn Header="Nama Akun" 
                Binding="{Binding AccountName}" ElementStyle="{StaticResource TextStyleWrapping}"
                Width="150"/>

                    <!-- Kolom Debet (Rata Kanan + Format Rupiah) -->
                    <DataGridTextColumn Header="Debet" 
                                    Binding="{Binding Debet, StringFormat={}{0:N2}}" 
                                    Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Kolom Kredit (Rata Kanan + Format Rupiah) -->
                    <DataGridTextColumn Header="Kredit" 
                                    Binding="{Binding Credit, StringFormat={}{0:N2}}" 
                                    Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Kolom Saldo Akhir Kumulatif -->
                    <DataGridTextColumn Header="Saldo" 
                                    Binding="{Binding Saldo, StringFormat={}{0:N2}}" 
                                    Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Margin" Value="0,0,5,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

    </Grid> 
 </UserControl>
    
