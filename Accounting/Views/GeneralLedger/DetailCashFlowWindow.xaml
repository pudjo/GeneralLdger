<Window x:Class="Accounting.Views.GeneralLedger.DetailCashFlowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Accounting.Views.GeneralLedger"
        mc:Ignorable="d"
         Title="Detail Cash Flow" Height="420" Width="700" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Editor: two-column layout (Label | Value) -->
        <Border Padding="8" BorderBrush="LightGray" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Code" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,6" FontWeight="SemiBold"/>
                <TextBox Text="{Binding CashFlowItem.Code, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="6,6,0,6"/>

                <TextBlock Text="Name" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,6" FontWeight="SemiBold"/>
                <TextBox Text="{Binding CashFlowItem.Name, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="6,6,0,6"/>

                <TextBlock Text="Parent Code" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,6" FontWeight="SemiBold"/>
                <TextBox Text="{Binding CashFlowItem.ParentCode, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Margin="6,6,0,6"/>

                <TextBlock Text="Group Type" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,6" FontWeight="SemiBold"/>
                <TextBox Text="{Binding CashFlowItem.GroupType, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" Margin="6,6,0,6"/>
            </Grid>
        </Border>

        <!-- Children list -->
        <GroupBox Header="Children" Grid.Row="1" Margin="0,10,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListView ItemsSource="{Binding CashFlowItem.Children}" SelectedItem="{Binding SelectedChild}" Grid.Row="0" Margin="6">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Code" Width="140" DisplayMemberBinding="{Binding Code}"/>
                            <GridViewColumn Header="Name" Width="360" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Group" Width="120" DisplayMemberBinding="{Binding GroupType}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- child editor (single-line compact editor) -->
                <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="6" HorizontalAlignment="Stretch">
                    <TextBox Width="140" Text="{Binding SelectedChild.Code, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                    <TextBox Width="300" Text="{Binding SelectedChild.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                    <TextBox Width="100" Text="{Binding SelectedChild.GroupType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Tambah Anak" Width="96" Margin="6,0" Command="{Binding AddChildCommand}"/>
            <Button Content="Update" Width="80" Margin="6,0" Command="{Binding UpdateCommand}" />
            <Button Content="Simpan" Width="80" Margin="6,0" Command="{Binding SaveCommand}" />
            <Button Content="Hapus" Width="80" Margin="6,0" Command="{Binding DeleteCommand}" />
            <Button Content="Tutup" Width="80" Margin="6,0" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>
