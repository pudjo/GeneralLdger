<Window x:Class="Accounting.Views.Account.DetailAkunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Accounting.Views.Account"
        mc:Ignorable="d"
        Title="DetailAkunWindow" Height="480" Width="850" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Form -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <TextBlock Text="Informasi Akun" FontSize="18pt" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C3E50"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <!-- Baris 1: ID, Nama, Root, dan CheckBox Saldo Normal Bersebelahan -->
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <!-- Lebar untuk ID -->
                    <ColumnDefinition Width="380"/>
                    <!-- Lebar untuk Nama -->
                    <ColumnDefinition Width="65"/>
                    <!-- Lebar untuk Root -->
                    <ColumnDefinition Width="*"/>
                    <!-- Lebar untuk Saldo Normal -->
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Kode Akun (ID)" Margin="0,5,0,2" FontWeight="Bold"/>
                    <TextBox Text="{Binding CurrentAkun.Id}" FontSize="14pt" Padding="5" FontWeight="Bold" IsEnabled="{Binding IsIdEditable}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Nama Akun" Margin="0,5,0,2" FontWeight="Bold"/>
                    <TextBox Text="{Binding CurrentAkun.Name}" FontSize="14pt" Padding="5" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Root" Margin="0,5,0,2" FontWeight="Bold" />
                    <TextBox Text="{Binding CurrentAkun.Root}" FontSize="14pt" Padding="5" FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Margin="0,0,0,5">
                    <TextBlock Text="Saldo Normal" Margin="0,0,0,6" FontWeight="Bold"/>
                    <CheckBox Content="Debet" 
                              IsChecked="{Binding CurrentAkun.BoolDebet, Mode=TwoWay}" 
                              FontSize="12pt" 
                              VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Keterangan Saldo Normal tepat di bawah bagian pilihan -->
            <TextBlock Text="* Saldo normal: kalau dicentang berarti Debet, kalau tidak dicentang berarti Kredit." 
                       FontStyle="Italic" 
                       FontSize="10pt" 
                       Foreground="Gray" 
                       Margin="0,0,0,15"/>

            <TextBlock Text="Induk" Margin="0,5,0,2"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <!-- ID Parent -->
                    <ColumnDefinition Width="*"/>
                    <!-- Nama Parent -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Tombol Cari -->
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding CurrentAkun.IdParent}" Margin="0,0,5,0" Padding="5" 
                 IsReadOnly="True" Background="#F9F9F9"/>

                <TextBox Grid.Column="1" Text="{Binding CurrentAkun.ParentName}" Margin="0,0,5,0" Padding="5" 
                 IsReadOnly="True" Background="#F9F9F9"/>

                <!-- Tombol Cari Rekening -->
                <Button Grid.Column="2" Content=" Ubah Induk " Command="{Binding SearchParentCommand}" 
                Padding="10,0" Background="LightBlue" Foreground="White" BorderThickness="0"/>
            </Grid>
        </StackPanel>

        <!-- Tombol Aksi -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Hapus" Command="{Binding DeleteCommand}" Width="80" Margin="5" Background="#E74C3C" Foreground="White" BorderThickness="0"/>
            <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Width="80" Margin="5" Background="#27AE60" Foreground="White" BorderThickness="0"/>
            <Button Content="Batal" Click="CloseButton_Click" Width="80" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>